          "type": "textarea",
          "required": true
        },
        {
          "id": "previous_dentist",
          "label": "Previous dentist",
          "type": "text"
        },
        {
          "id": "last_visit",
          "label": "Date of last dental visit",
          "type": "text"
        },
        {
          "id": "last_xray",
          "label": "Date of last dental X-rays",
          "type": "text"
        },
        {
          "id": "last_cleaning",
          "label": "Date of last cleaning",
          "type": "text"
        },
        {
          "id": "brushing",
          "label": "How often do you brush?",
          "type": "text"
        },
        {
          "id": "flossing",
          "label": "How often do you floss or use a water flosser?",
          "type": "text"
        },
        {
          "id": "dental_symptoms",
          "label": "Dental concerns or previous treatment (select all that apply)",
          "type": "checkboxes",
          "choices": [
            "Bleeding gums",
            "Loose teeth",
            "Broken or lost fillings",
            "Sensitivity to cold",
            "Sensitivity to heat",
            "Sensitivity to sweets",
            "Pain when biting",
            "Food catching between teeth",
            "Bad breath or bad taste",
            "Dry mouth",
            "Sores or lumps in the mouth",
            "Jaw clicking or popping",
            "Jaw pain or limited opening",
            "Clenching or grinding",
            "Headaches on waking",
            "Difficulty chewing",
            "Dentures or partials that do not fit",
            "Gum (periodontal) treatment",
            "Root canal treatment",
            "Orthodontics / braces",
            "Teeth whitening",
            "Snoring or sleep apnea",
            "I avoid smiling in photos",
            "Dental anxiety or fear",
            "None of these",
            "Not sure"
          ],
          "exclusive": [
            "None of these",
            "Not sure"
          ],
          "required": true
        },
        {
          "id": "implant_0",
