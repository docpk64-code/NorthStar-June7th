{
  "title": "New Patient Registration & Health History",
  "revision": "November 2026",
  "sections": [
    {
      "id": "patient",
      "title": "Patient information",
      "intro": "Complete your details and tell us how we can help. No full Social Security number is requested.",
      "fields": [
        {
          "id": "first_name",
          "label": "First name",
          "type": "text",
          "required": true
        },
        {
          "id": "last_name",
          "label": "Last name",
          "type": "text",
          "required": true
        },
        {
          "id": "middle",
          "label": "Middle name",
          "type": "text"
        },
        {
          "id": "preferred_name",
          "label": "Preferred name",
          "type": "text"
        },
        {
          "id": "dob",
          "label": "Date of birth",
          "type": "date",
          "required": true
        },
        {
          "id": "office",
          "label": "Preferred office",
          "type": "radio",
          "choices": [
            "Briarwood / Queens",
            "Manhattan",
            "Commack",
            "Brooklyn - opening January 4, 2027"
          ],
          "required": true
        },
        {
          "id": "pronouns",
          "label": "Pronouns (optional)",
          "type": "text"
        },
        {
          "id": "address",
          "label": "Street address and apartment",
          "type": "text"
        },
        {
          "id": "city",
          "label": "City",
          "type": "text"
        },
        {
          "id": "state",
          "label": "State",
          "type": "text"
        },
        {
          "id": "zip",
          "label": "ZIP code",
          "type": "text"
        },
        {
          "id": "mobile",
          "label": "Mobile phone",
          "type": "tel"
        },
        {
          "id": "other_phone",
          "label": "Other phone",
          "type": "tel"
        },
        {
          "id": "email",
          "label": "Email address",
          "type": "email"
        },
        {
          "id": "employer",
          "label": "Employer or school",
          "type": "text"
        },
        {
          "id": "emergency_name",
          "label": "Emergency contact name and relationship",
          "type": "text"
        },
        {
          "id": "emergency_phone",
          "label": "Emergency contact phone",
          "type": "tel"
        },
        {
          "id": "pharmacy",
          "label": "Preferred pharmacy and location",
          "type": "text"
        },
        {
          "id": "pharmacy_phone",
          "label": "Pharmacy phone",
          "type": "tel"
        },
        {
          "id": "referral",
          "label": "Who referred you?",
          "type": "text"
        },
        {
          "id": "language",
          "label": "Preferred language",
          "type": "text"
        },
        {
          "id": "assistance",
          "label": "Assistance requested",
          "type": "checkboxes",
          "choices": [
            "Interpreter",
            "Large-print materials",
            "Wheelchair access",
            "Help completing forms"
          ]
        },
        {
          "id": "responsible",
          "label": "Is someone else responsible for payment, or completing this form for you?",
          "type": "radio",
          "choices": [
            "Yes",
            "No"
          ],
          "required": true
        },
        {
          "id": "representative",
          "label": "If yes: name, relationship / legal authority, date of birth, phone, email, and address if different",
          "type": "textarea",
          "showIf": {
            "id": "responsible",
            "values": [
              "Yes"
            ]
          }
        }
      ]
    },
    {
      "id": "insurance",
      "title": "Insurance",
      "intro": "Bring your insurance cards. Your team will verify benefits; an estimate is not a guarantee of coverage.",
      "fields": [
        {
          "id": "insurance_status",
          "label": "Coverage",
          "type": "radio",
          "choices": [
            "Dental insurance",
            "Medical insurance",
            "Dental and medical insurance",
            "No insurance / self-pay",
            "Not sure"
          ],
          "required": true
        },
        {
          "id": "dental_primary",
          "label": "Primary dental plan: carrier, member ID, group number, subscriber name / date of birth / relationship, employer and plan phone",
          "type": "textarea"
        },
        {
          "id": "dental_secondary",
          "label": "Secondary dental plan (if any): carrier, member ID, group number, subscriber name / date of birth / relationship, employer and plan phone",
          "type": "textarea"
        },
        {
          "id": "medical_plan",
          "label": "Medical plan (if applicable): carrier, member ID, group number, subscriber name / date of birth / relationship, employer and plan phone",
          "type": "textarea"
        },
        {
          "id": "insurance_notes",
          "label": "Insurance requests",
          "type": "checkboxes",
          "choices": [
            "Please verify my benefits before treatment",
            "I have a health savings / flexible spending account"
          ]
        }
      ]
    },
    {
      "id": "dental",
      "title": "Dental and implant history",
      "intro": "Tell us about your concerns and previous dental treatment.",
      "fields": [
        {
          "id": "concerns",
